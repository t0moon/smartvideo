# LLM Configuration
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (requirement + storyboard + scenes LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Video Provider
VIDEO_PROVIDER=kling
VIDEO_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_SIZE=1280x720

# Kling 2.5 Turbo (new Kling AI API)
KLING_API_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-2.5-turbo
KLING_DURATION=5
KLING_ASPECT_RATIO=16:9
KLING_RESOLUTION=720p
KLING_AUDIO=off

# Audio
AUDIO_ENABLE=1
AUDIO_TTS_PROVIDER=openai
AUDIO_TTS_MODEL=gpt-4o-mini-tts
AUDIO_TTS_VOICE=alloy

# Feishu Integration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REVIEWER_OPEN_ID=
# Callback mode: webhook (HTTP, needs public URL) or ws (long connection, no public URL needed)
FEISHU_CALLBACK_MODE=ws

# Langfuse Observability
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
